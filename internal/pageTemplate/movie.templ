package pageTemplate

import "github.com/tylerBrittain42/lets-pick-a-movie/internal/database"

templ PageMovie(movie database.GetMovieRow) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Movies</title>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			@header()
			@movieCard(movie.Name, movie.Year)
		</body>
	</html>
}
